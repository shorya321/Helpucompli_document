# ===========================================
# HelpUcompli Document Repository
# Copy to .env and fill in values
# ===========================================
APP_BASE_URL=http://localhost:3000

# --- Auth0 ---
AUTH0_SECRET=          # Random 32+ char secret (openssl rand -hex 32)
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Auth0 Management API (for RBAC role resolution + user management)
# MUST be a Machine-to-Machine application, NOT the Regular Web App
# used for user login. Create via Auth0 Dashboard → Applications → +
# Create Application → Machine to Machine Applications.
# After creation, authorise it against "Auth0 Management API" with:
#   - read:roles
#   - read:role_members
# (Module 10 additionally needs create:users, read:users, update:users,
# create:user_tickets)
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# OPTIONAL. Name of the Auth0 database connection that stores
# application users. Invite flow (F10.3) creates new users in this
# connection. Defaults to 'Username-Password-Authentication' when
# unset — matches Auth0's default tenant connection.
AUTH0_DB_CONNECTION=

# Primary domain users hit for login. Can be a custom domain
# (e.g. auth.helpucompli.com) or the raw Auth0 tenant domain.
AUTH0_DOMAIN=YOUR_TENANT.auth0.com

# OPTIONAL. Required ONLY when AUTH0_DOMAIN is a custom domain —
# Auth0 Management API issues M2M tokens against the raw tenant
# domain as audience, not the custom-domain alias. Look up in Auth0
# Dashboard → Settings → Custom Domains ("Original domain"). Leave
# blank when AUTH0_DOMAIN is already the raw tenant.
AUTH0_TENANT_DOMAIN=

# --- AWS S3 ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_KMS_KEY_ID=        # KMS CMK ARN for SSE-KMS encryption
AWS_S3_LOGS_BUCKET=helpucompli-docs-access-logs

# --- Database ---
DATABASE_URL=postgresql://user:password@host:5432/helpucompli_docs

# --- Upstash Redis (Rate Limiting) ---
# OPTIONAL in dev (blank → falls back to per-process in-memory limiter).
# REQUIRED in production — the rate-limit factory throws on boot when
# NODE_ENV=production and these are unset (see src/lib/rate-limit.ts).
# Blank strings are treated as unset by config.ts preprocess — safe.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Monitoring ---
# OPTIONAL. Blank strings treated as unset (safe).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
