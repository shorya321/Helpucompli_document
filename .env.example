# ===========================================
# HelpUcompli Document Repository
# Copy to .env and fill in values
# ===========================================
APP_BASE_URL=http://localhost:3000

# --- Auth0 ---
AUTH0_SECRET=          # Random 32+ char secret (openssl rand -hex 32)
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Auth0 Management API (for user management)
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
AUTH0_DOMAIN=YOUR_TENANT.auth0.com

# --- AWS S3 ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_KMS_KEY_ID=        # KMS CMK ARN for SSE-KMS encryption
AWS_S3_LOGS_BUCKET=helpucompli-docs-access-logs

# --- Database ---
DATABASE_URL=postgresql://user:password@host:5432/helpucompli_docs

# --- Upstash Redis (Rate Limiting) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Monitoring ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
