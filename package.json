{
  "name": "helpucompli-document-repository",
  "version": "0.1.0",
  "private": true,
  "description": "HIPAA-compliant document repository at docs.helpucompli.com",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && npm run lint:tokens",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:clean": "prisma db execute --file ./prisma/clean.sql --schema ./prisma/schema.prisma",
    "db:clean:all": "prisma db execute --file ./prisma/clean-all.sql --schema ./prisma/schema.prisma",
    "typecheck": "tsc --noEmit",
    "check-progress": "./scripts/check-progress.sh",
    "postinstall": "node scripts/copy-pdfjs.mjs",
    "copy-pdfjs": "node scripts/copy-pdfjs.mjs"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.27.0",
    "@aws-sdk/client-cloudtrail": "^3.1120.0",
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.1120.0",
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^8.21.3",
    "@upstash/ratelimit": "^2.0.0",
    "@upstash/redis": "^1.38.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.3.3",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.2.108",
    "pino": "^9.5.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^14.4.1",
    "react-hook-form": "^7.86.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^16.6.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
    "prisma": "^6.6.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "esbuild": "~0.28.0",
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "nanoid": "^3.3.18",
    "deepmerge-ts": "^8.0.1"
  }
}
